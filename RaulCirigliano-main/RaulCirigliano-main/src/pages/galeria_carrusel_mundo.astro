---
import Layout from '../components/Layout.astro';
const extraCss = ['galeria_carrusel_mundo.css', 'tipografia.css'];
---

<Layout 
  titulo="Esfera de Arte 3D"
  descripcion="Explora las obras de arte en 3D a través de este carrusel interactivo."
  palabrasClave="escultor, ceramista, artista, Arte Barro, arte 3D, interactivo"
  imagenOG="https://raulcirigliano.com/imagenes/generales/fondo_3.webp"
  extraCss={extraCss}
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "WebPage",
      "name": "Esfera de Arte 3D",
      "url": "https://raulcirigliano.com/carrusel_mundo.html"
    }
    </script>
  </Fragment>

<div id="c_m_scene">
        <!-- Esfera 3D -->
        <div id="c_m_sphere"></div>
        
        <!-- Controlador de rotación -->
        <div class="c_m_slider_container">
            <button id="c_m_back_btn" class="c_m_glass-btn c_m_back_btn">Volver atrás</button>
            <label for="c_m_slider" class="c_m_slider_label">Girar mundo de fotografías</label>
            <input type="range" id="c_m_slider" min="0" max="360" value="0" class="c_m_slider_input">
        </div>
    </div>
</Layout>
