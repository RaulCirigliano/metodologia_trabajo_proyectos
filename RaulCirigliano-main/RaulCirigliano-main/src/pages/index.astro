---
import Layout from '../components/Layout.astro';
const extraCss = ['tipografia.css'];
---

<Layout 
  titulo="Raul Cirigliano | Ingresar"
  descripcion="Portada de acceso al universo artístico de Raul Cirigliano."
  palabrasClave="escultor, ceramista, artista, Arte Barro, inicio, portada"
  imagenOG="https://raulcirigliano.com/imagenes/el_duende.webp"
  hideHeaderFooter={true}
  extraCss={extraCss}
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Person",
      "name": "Raúl Cirigliano",
      "jobTitle": "Escultor y Ceramista",
      "description": "Artista, escultor y ceramista de gran trayectoria. Una puerta de entrada al proceso, a la obra terminada y a las piezas disponibles.",
      "url": "https://raulcirigliano.com",
      "image": "https://raulcirigliano.com/imagenes/el_duende.webp",
      "knowsAbout": ["Cerámica", "Escultura", "Arte Contemporáneo", "Esmaltado"]
    }
    </script>
  </Fragment>

<main class="site-entry">
        <div class="site-entry-grid" aria-hidden="true">
            <span class="entry-cell cell-a"><img src="imagenes/galeria_procesos/mtp/mtp_15.webp" alt="" loading="lazy"></span>
            <span class="entry-cell cell-b"><img src="imagenes/galeria_procesos/mtp/mtp_4.webp" alt="" loading="lazy"></span>
            <span class="entry-cell cell-c"><img src="imagenes/galeria_procesos/mtp/mtp_23.webp" alt="" loading="lazy"></span>
            <span class="entry-cell cell-d"><img src="imagenes/galeria_procesos/varios/cabeza_meishu.webp" alt="" loading="lazy"></span>
            <span class="entry-cell cell-e"><img src="imagenes/galeria_procesos/mtp/mtp_13.webp" alt="" loading="lazy"></span>
            <span class="entry-cell cell-f"><img src="imagenes/galeria_procesos/mtp/mtp_6.webp" alt="" loading="lazy"></span>
        </div>

        <div class="site-entry-overlay"></div>

        <div class="site-entry-content">
            <p class="site-entry-kicker">Raúl Cirigliano</p>
            <h1>Arcilla, presencia y contemplación.</h1>
            <p class="site-entry-copy">
                Una puerta de entrada al proceso, a la obra terminada y a las piezas disponibles.   
            </p>
            <a class="site-entry-cta" href="inicio.html" aria-label="Ingresar al sitio">
                Ingresar al sitio
            </a>
        </div>
    </main>
</Layout>
