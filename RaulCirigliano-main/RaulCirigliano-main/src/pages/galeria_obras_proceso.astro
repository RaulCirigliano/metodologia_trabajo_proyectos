        </section>

        <section class="video-component-container">
            <div class="main-video-wrapper">
                <div id="main-video-player" class="lite-youtube" data-video-id="uZVOdYXZnMo">
                    <img loading="lazy" src="https://img.youtube.com/vi/uZVOdYXZnMo/maxresdefault.jpg" alt="Portada del video" id="main-video-thumb">
                    <button class="play-button" aria-label="Reproducir video"></button>
                </div>
                <h3 id="main-video-title">Video de proceso 1</h3>
            </div>
            <div class="video-carousel">
                <div class="carousel-item active" data-id="uZVOdYXZnMo" data-title="Video de proceso 1">
                    <img src="https://img.youtube.com/vi/uZVOdYXZnMo/mqdefault.jpg" alt="Miniatura Video de proceso 1" loading="lazy" decoding="async">
                    <p>Video de proceso 1</p>
                </div>
                <div class="carousel-item" data-id="tfNCwNjJ5xs" data-title="Video de proceso 2">
