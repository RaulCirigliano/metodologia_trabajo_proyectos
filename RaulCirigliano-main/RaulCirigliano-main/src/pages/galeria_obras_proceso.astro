---
import Layout from '../components/Layout.astro';
const extraCss = ['tipografia.css'];
---

<Layout 
  titulo="Raul Cirigliano | Galería de Obras en Proceso"
  descripcion="Explora el proceso creativo de Raul Cirigliano en escultura y cerámica. 
    Especialista en técnicas de modelado, horneados y modelado de piezas únicas en arcilla."
  palabrasClave="escultor, ceramista, artista, Arte Barro, obras en proceso, arcilla"
  imagenOG="https://raulcirigliano.com/imagenes/mujer_t_p.webp"
  hideHeaderFooter={true}
  extraCss={extraCss}
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Person",
      "name": "Raúl Cirigliano",
      "jobTitle": "Escultor y Ceramista",
      "description": "Artista dedicado a la escultura en cerámica con enfoque en técnicas tradicionales y experimentales.",
      "url": "https://raulcirigliano.com",
      "image": "https://raulcirigliano.com/imagenes/mujer_t_p.webp"
    }
    </script>
  </Fragment>

<!-- Main Content -->
    <main>
        <!-- Gallery Section -->
        <section class="gallery" id="galeria">
            <div class="container">

                <div class="section-title">
                    <h1>Galería de Obras en Proceso</h1>
                </div>

                <div class="gallery-filters">
                    <button class="filter-btn active" data-filter="all">Todas</button>
                    <button class="filter-btn" onclick="window.location.href='en_preparacion.html'">Esculturas</button>
                    <button class="filter-btn" onclick="window.location.href='en_preparacion.html'">Cerámica</button>
                    <button class="filter-btn" onclick="window.location.href='en_preparacion.html'">Exposiciones</button>
                </div>

                <div class="gallery-item spaced-item" data-category="escultura">
                    <img src="imagenes/galeria_procesos/mtp/mtp_2.webp" alt="Mujer tomandose el pelo 1" loading="lazy" decoding="async">
                    <div class="item-info">
                        <h3>Mujer tomandose el pelo 1</h3>
                        <p>En proceso</p>
                    </div>
                </div>

                <div class="gallery-grid">

                    <div class="gallery-item" data-category="escultura">
                        <img src="imagenes/galeria_procesos/mtp/mtp_3.webp" alt="Mujer tomandose el pelo 2" loading="lazy" decoding="async">
                        <div class="item-info">
                            <h3>Mujer tomandose el pelo 2</h3>
                            <p>En proceso</p>
                        </div>
                    </div>

                    <div class="gallery-item" data-category="escultura">
                        <img src="imagenes/galeria_procesos/mtp/mtp_10.webp" alt="Mujer tomandose el pelo 3" loading="lazy" decoding="async">
                        <div class="item-info">
                            <h3>Mujer tomandose el pelo 3</h3>
                            <p>En proceso</p>
                        </div>
                    </div>

                    <div class="gallery-item" data-category="escultura">
                        <img src="imagenes/galeria_procesos/mtp/mtp_21.webp" alt="Mujer tomandose el pelo 4" loading="lazy" decoding="async">
                        <div class="item-info">
                            <h3>Mujer tomandose el pelo 4</h3>
                            <p>En proceso</p>
                        </div>
                    </div>

                    <div class="gallery-item" data-category="escultura">
                        <img src="imagenes/galeria_procesos/el_grito/el_grito_2.webp" alt="El grito 1" loading="lazy"
                            decoding="async">
                        <div class="item-info">
                            <h3>El Grito 1</h3>
                            <p>En proceso</p>
                        </div>
                    </div>

                    <div class="gallery-item" data-category="escultura">
